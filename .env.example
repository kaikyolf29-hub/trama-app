# Variáveis do Trama. Copie para .env (site) e para apps/*/.dev.vars (Workers) e preencha.
# Nunca commite valores reais: em produção eles ficam nos painéis da Cloudflare, do
# Supabase e do GitHub (AGENTS.md, "O que nunca fazer").
#
# Prefixo VITE_ = vai para o navegador, então só entra o que pode ser público.
# Sem prefixo = só nos Workers (apps/api e apps/mcp) ou no CI.

# --- App ---------------------------------------------------------------------
# Endereço do site e da API. Em desenvolvimento, o Vite roda na porta 5173.
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:8787
APP_URL=http://localhost:5173
# Fuso padrão de quem ainda não escolheu o seu (profiles.timezone).
DEFAULT_TIMEZONE=America/Sao_Paulo

# --- Supabase (banco, login e arquivos) --------------------------------------
# Painel do projeto > Project Settings > API Keys.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...). Pode ir para o navegador: a RLS protege os dados.
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave secreta (sb_secret_...). Só no Worker da API. Ignora a RLS: nunca no navegador.
SUPABASE_SECRET_KEY=
# Só para a CLI do Supabase aplicar migrations pelo CI.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# --- Google (login com Google e Google Drive) --------------------------------
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (aplicativo web).
# O login com Google também usa o mesmo ID e segredo, configurados no painel do Supabase.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave de API restrita ao Google Picker ("Abrir do Drive").
VITE_GOOGLE_API_KEY=
# Número do projeto no Google Cloud. O Picker precisa dele com o escopo drive.file.
VITE_GOOGLE_APP_ID=

# --- Resend (e-mails) --------------------------------------------------------
RESEND_API_KEY=
# Remetente. O domínio precisa de SPF e DKIM configurados antes do lançamento.
EMAIL_FROM="Trama <ola@SEU-DOMINIO>"

# --- Cloudflare (Workers e deploy) -------------------------------------------
# Usadas pelo wrangler no CI para publicar o site, a API, o MCP e os previews.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Chaves de IA das pessoas ------------------------------------------------
# Não existe chave de IA do Trama: cada pessoa usa a própria, guardada em ai_keys.
# Esta é a chave que criptografa essas chaves no banco. Só no Worker da API.
# Gere com: openssl rand -base64 32
AI_KEYS_ENCRYPTION_KEY=
