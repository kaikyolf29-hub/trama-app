# Variáveis do Trama. Este é o único arquivo de exemplo do repositório; cada seção diz
# para onde a variável vai. Nunca commite valores reais: em produção eles ficam nos
# painéis da Cloudflare, do Supabase e do GitHub (AGENTS.md, "O que nunca fazer").
#
# O site abre sem nenhuma variável enquanto não há login; elas passam a valer a partir
# da tarefa de login.

# =============================================================================
# apps/web/.env  ->  o Vite lê o .env da pasta apps/web
# Só variáveis com prefixo VITE_, e só o que pode ir para o navegador.
# =============================================================================
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:8787
# Supabase > Project Settings > API Keys.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...). Pode ir para o navegador: a RLS protege os dados.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Google Drive (Fase 1). Não é login: o login é por e-mail e senha.
# Google Cloud Console > Credenciais: ID do cliente OAuth, chave de API restrita ao
# Picker ("Abrir do Drive") e o número do projeto, que o Picker exige com drive.file.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# =============================================================================
# apps/api/.dev.vars  ->  o wrangler lê o .dev.vars da pasta de cada Worker
# Em produção: wrangler secret put NOME (ou o painel da Cloudflare).
# =============================================================================
APP_URL=http://localhost:5173
# Fuso padrão de quem ainda não escolheu o seu (profiles.timezone).
DEFAULT_TIMEZONE=America/Sao_Paulo
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave secreta (sb_secret_...). Ignora a RLS: só no Worker, nunca no navegador.
SUPABASE_SECRET_KEY=
# Resend: e-mails do app (boas-vindas, aviso do Drive, resumo semanal).
RESEND_API_KEY=
# O domínio do remetente precisa de SPF e DKIM verificados no Resend.
EMAIL_FROM="Trama <ola@SEU-DOMINIO>"
# Google Drive (Fase 1): troca do código OAuth pelo token de acesso ao Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Não existe chave de IA do Trama: cada pessoa usa a própria, guardada em ai_keys.
# Esta chave criptografa essas chaves no banco. Gere com: openssl rand -base64 32
AI_KEYS_ENCRYPTION_KEY=

# =============================================================================
# apps/mcp/.dev.vars  ->  Worker do conector MCP (Fase 3)
# =============================================================================
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SECRET_KEY=

# =============================================================================
# Painel do Supabase (Authentication > Emails > SMTP Settings) e supabase/config.toml
# Os e-mails de login (recuperação de senha, troca de e-mail) saem pelo Resend.
# =============================================================================
# Host: smtp.resend.com · Porta: 465 · Usuário: resend · Senha: a RESEND_API_KEY acima
# Remetente: o mesmo EMAIL_FROM

# =============================================================================
# Segredos do GitHub Actions (Settings > Secrets and variables > Actions)
# =============================================================================
# Deploy do site, da API e dos previews pelo wrangler.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLI do Supabase aplicando as migrations.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
